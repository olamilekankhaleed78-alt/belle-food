# Copy these into Vercel > Settings > Environment Variables. Never commit real values.

# Neon pooled connection string (starts with postgresql://)
DATABASE_URL=

# Admin login. Without BOTH of these, the admin area stays locked.
# Password: at least 12 characters. A long passphrase is best.
ADMIN_PASSWORD=
# Secret used to sign login sessions: at least 32 random characters. Never reuse the password.
ADMIN_JWT_SECRET=

# Optional: business WhatsApp number for order alerts (international format, e.g. 2348012345678)
KITCHEN_WHATSAPP_NUMBER=

# Optional: photo uploads (create a free Cloudinary account)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
